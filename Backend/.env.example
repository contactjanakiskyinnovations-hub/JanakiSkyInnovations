# ============ EcommerceDrone Backend — Environment Template ============
# Copy this file to `.env` and fill in real values. NEVER commit your real .env.

# development | production
NODE_ENV=production

# Port the Express server listens on
PORT=5000

# MongoDB connection string (use MongoDB Atlas in production)
MONGO_URI=mongodb://127.0.0.1:27017/ecommercedrone

# JWT: use a LONG random string. Rotating it invalidates all existing sessions.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRE=30d

# ImageKit.io credentials (ImageKit account)
IMAGEKIT_PUBLIC_KEY=your_public_key
IMAGEKIT_PRIVATE_KEY=your_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_endpoint

# Comma-separated list of allowed frontend origins (production)
# e.g. https://yourstore.com,https://www.yourstore.com
# Leave empty in development (localhost is always allowed).
CORS_ORIGINS=

# Public site URL (used by robots.txt / sitemap.xml). Set to your production
# storefront domain, e.g. https://www.yourstore.com
# Leave empty in development (defaults to http://localhost:5173).
SITE_URL=
