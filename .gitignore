# ----- Dependencies (never commit) -----
**/node_modules/

# ----- Environment / secrets (never commit) -----
.env
.env.*
!.env.example

# ----- Build output -----
**/dist/
**/dist-ssr/

# ----- Logs -----
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ----- Editor / OS -----
.idea/
.vscode/*
!.vscode/extensions.json
.DS_Store
Thumbs.db

# ----- Misc dev artifacts -----
*.tmp
*.swp