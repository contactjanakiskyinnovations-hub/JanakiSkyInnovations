# ============ EcommerceDrone Frontend — Environment Template ============
# Copy this file to `.env` and fill in real values. NEVER commit your real .env.

# Backend API base URL (used by src/utils/api.js).
# Defaults to http://localhost:5000 in development.
VITE_API_URL=https://api.yourstore.com

# Public storefront URL — used for canonical links and Open Graph URLs.
# Defaults to https://www.janakiskyinnovations.com
VITE_SITE_URL=https://www.janakiskyinnovations.com

# Optional: brand name shown in <title> / structured data.
# Defaults to "Janaki Sky Innovations".
VITE_SITE_NAME=Janaki Sky Innovations
